// work-navi · Prisma schema (SQLite)
// 个人项目资源导航台 —— 数据模型
// 说明:密码明文存储,服务默认仅监听 localhost,仅供本机使用。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String     @id @default(cuid())
  name      String
  desc      String?
  color     String     @default("indigo")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  resources Resource[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("other")
  order     Int        @default(0)
  resources Resource[]
}

model Resource {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title      String
  url        String?
  note       String?
  username   String?
  password   String? // 明文
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([projectId])
  @@index([categoryId])
}

model WeekNote {
  id        String   @id @default(cuid())
  isoYear   Int
  isoWeek   Int
  startDate DateTime
  endDate   DateTime
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([isoYear, isoWeek])
}
