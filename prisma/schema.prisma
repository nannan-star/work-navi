// work-navi · Prisma schema (SQLite)
// 个人项目资源导航台 —— 数据模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id         String     @id @default(cuid())
  name       String
  desc       String?
  color      String     @default("indigo")
  order      Int        @default(0)
  memo       String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  resources  Resource[]
  categories Category[]
}

model Category {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String     @default("other")
  order     Int        @default(0)
  resources Resource[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Resource {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  note       String?
  username   String?
  password   String?
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  links      ResourceLink[]

  @@index([projectId])
  @@index([categoryId])
}

model ResourceLink {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  label      String   @default("地址")
  url        String
  order      Int      @default(0)

  @@index([resourceId])
}

model WeekNote {
  id        String   @id @default(cuid())
  isoYear   Int
  isoWeek   Int
  startDate DateTime
  endDate   DateTime
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([isoYear, isoWeek])
}
